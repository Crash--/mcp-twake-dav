# mcp-twake-dav: copy to .env for local development. Never commit real credentials.
DAV_URL=https://dav.example.com

# Basic auth (default)
DAV_USERNAME=your_username
DAV_PASSWORD=your_password

# Or Bearer / OpenPaaS ESNToken
# DAV_AUTH_METHOD=bearer        # or esntoken
# DAV_TOKEN=your_token

# Or token command (external broker printing an access token)
# DAV_AUTH_METHOD=command
# DAV_TOKEN_COMMAND=/usr/local/bin/my-token-broker token

# Or keep secrets in a separate file (DAV_USERNAME=/DAV_PASSWORD=/DAV_TOKEN= lines)
# DAV_CREDENTIALS_FILE=~/.config/mcp-twake-dav/credentials

# Optional
# DAV_DEFAULT_CALENDAR=My Calendar
# DAV_DEFAULT_ADDRESSBOOK=My Contacts
# DAV_ORGANIZER_EMAIL=jane.doe@example.com
# DAV_ORGANIZER_NAME=Jane Doe
# DAV_RECURRING_WRITES=true
# DAV_HREF_PREFIX=/dav          # Twake Calendar / OpenPaaS
# USER_TIMEZONE=Europe/Paris
LOG_LEVEL=info
